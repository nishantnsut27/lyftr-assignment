# Copy to .env at the repository root. Replace placeholders locally; never commit .env.
# IDs are assigned in this order: key_1, key_2, key_3.
LLM_API_KEYS=replace_with_groq_key_1,replace_with_groq_key_2,replace_with_groq_key_3
LLM_MODEL=groq/openai/gpt-oss-20b

# Local non-Docker paths. Compose always overrides storage to
# sqlite:////data/app.db and /data/llm-cache on the named lyftr_data volume.
# Configure those same /data paths with a persistent disk on Render.
DATABASE_URL=sqlite:///./data/app.db
LLM_CACHE_DIR=./data/llm-cache
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT="You are a helpful assistant. Answer clearly and concisely."
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
PORT=8000

# Compose publishes the assignment frontend on 127.0.0.1:3000.
# Keep FRONTEND_PORT=3000 for the required local acceptance check.
# The internal Nginx port stays 3000. make down preserves lyftr_data.
FRONTEND_PORT=3000

# The browser's API URL, baked into the frontend at build time, not runtime.
# Rebuild with make up after changing it. Only this value goes to the frontend
# build; credentials are passed exclusively to the backend at runtime.
VITE_API_BASE_URL=http://localhost:8000

# Hosting dashboards: backend settings in Render, VITE_API_BASE_URL in Vercel.
# Private .env.render/.env.vercel files are imported into hosting dashboards;
# the platforms do not automatically load these filenames from the repository.

# Oracle backend only: public DNS hostname for Caddy's automatic HTTPS.
# Replace with a hostname that resolves to the VM's public IP.
BACKEND_HOSTNAME=replace_with_vm_ip.sslip.io
