# Copy to .env at the repository root. Replace placeholders locally; never commit .env.
# IDs are assigned in this order: key_1, key_2, key_3.
LLM_API_KEYS=replace_with_groq_key_1,replace_with_groq_key_2,replace_with_groq_key_3
LLM_MODEL=groq/openai/gpt-oss-20b

# Local non-Docker paths. Compose/Render override these to /data.
DATABASE_URL=sqlite:///./data/app.db
LLM_CACHE_DIR=./data/llm-cache
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT="You are a helpful assistant. Answer clearly and concisely."
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
PORT=8000

# Public API URL at frontend build time. No credentials belong in frontend variables.
VITE_API_BASE_URL=http://localhost:8000
