# Private environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json

# Local documentation and agent tooling; README will be published separately
*.[mM][dD]
.github/
.codex/
.agents/

# Test publication: include the backend tests required by the assessment
tests/
test/
__tests__/
*.test.*
*.spec.*
test_*.py
*_test.py
!backend/tests/
!backend/tests/*.py

# Python dependencies, bytecode, and tool caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pytest-cache-files-*/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.hypothesis/
.coverage
htmlcov/

# Frontend dependencies, builds, and test reports
node_modules/
dist/
coverage/
playwright-report/
test-results/
.vercel/

# Local SQLite history, LiteLLM cache, and generated artifacts
data/
*.db
*.db-shm
*.db-wal
*.sqlite*
.cache/
tmp/
output/
*.log

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
